<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="INFO">
    <Properties>
        <Property name="pattern">
            %d{yyyy-MM-dd HH:mm:ss.SSS} [%level] [thread-id %T] %l - %msg%n
        </Property>
    </Properties>

    <Appenders>
        <!-- Console Output -->
        <Console name="ConsoleAppender" target="SYSTEM_OUT">
            <PatternLayout pattern="${pattern}"/>
        </Console>

        <!-- File Output -->
        <File name="FileAppender"
              fileName="target/Reports/ATF_Console_Logs-${date:yyyyMMdd}.log"
              immediateFlush="true"
              append="false">
            <PatternLayout pattern="${pattern}"/>
        </File>
    </Appenders>

    <Loggers>

        <!-- 🔕 Hide TestNG internal logs -->
        <Logger name="org.testng" level="WARN" additivity="false">
            <AppenderRef ref="FileAppender"/>
        </Logger>

        <!-- 🔕 Hide TestNG Graph noise -->
        <Logger name="org.testng.internal" level="WARN" additivity="false">
            <AppenderRef ref="FileAppender"/>
        </Logger>

        <!-- Optional: Hide Selenium internal noise -->
        <Logger name="org.openqa.selenium" level="WARN"/>

        <!-- Root Logger -->
        <Root level="INFO">
            <AppenderRef ref="FileAppender"/>
            <!-- Add this only if you want console logs -->
            <!-- <AppenderRef ref="ConsoleAppender"/> -->
        </Root>

    </Loggers>
</Configuration>
